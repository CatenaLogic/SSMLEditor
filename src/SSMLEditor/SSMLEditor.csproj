<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <AssemblyName>SSMLEditor</AssemblyName>
    <RootNamespace>SSMLEditor</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PackageId>SSMLEditor</PackageId>
    <Title>SSML Editor</Title>
    <Description>SSML Editor to synchronize video and Text to Speech (TTS) translations.</Description>
    <PackageTags>ssml azure cognitive tts text speech editor</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <UseWpf>true</UseWpf>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- SonarQube requires a project guid -->
    <ProjectGuid>1DA4822C-8916-46AA-AA8B-3457993DDF85</ProjectGuid>
  </PropertyGroup>
  
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject />
    <NoWarn>$(NoWarn);SA1652</NoWarn>
    <ApplicationIcon>Resources\Icons\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Catel.MVVM" Version="7.0.0-alpha0311" />
    <PackageReference Include="Catel.Fody" Version="7.1.0-alpha0016" PrivateAssets="all" />
    <PackageReference Include="Catel.SourceGenerators" Version="7.1.0-alpha0052" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all">
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="MethodTimer.Fody" Version="3.2.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.49.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.7" />
    <PackageReference Include="Orc.Controls" Version="6.0.0-alpha0160" />
    <PackageReference Include="Orc.LogViewer" Version="6.0.0-alpha0112" />
    <PackageReference Include="Orc.Notifications" Version="6.0.0-alpha0103" />
    <PackageReference Include="Orc.ProjectManagement" Version="5.3.0-alpha0548" />
    <PackageReference Include="Orc.SelectionManagement" Version="6.0.0-alpha0090" />
    <PackageReference Include="Orc.Serialization.Json" Version="6.0.0-alpha0122" />
    <PackageReference Include="Orc.Squirrel.Xaml" Version="6.0.0-alpha0131" />
    <PackageReference Include="Orc.Wizard" Version="6.0.0-alpha0127" />
    <PackageReference Include="Orchestra.Shell.Ribbon.Fluent" Version="8.0.0-alpha0177" />
  </ItemGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\Directory.Build.shared.explicit.props" Condition="Exists('$(MSBuildProjectDirectory)\..\Directory.Build.shared.explicit.props')" />
  <Import Project="$(MSBuildProjectDirectory)\..\Directory.Build.shared.mat.props" Condition="Exists('$(MSBuildProjectDirectory)\..\Directory.Build.shared.mat.props')" />
  <Import Project="$(MSBuildProjectDirectory)\..\Directory.Build.shared.tools.props" Condition="Exists('$(MSBuildProjectDirectory)\..\Directory.Build.shared.tools.props')" />
</Project>
